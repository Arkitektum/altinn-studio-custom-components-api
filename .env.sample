API_PORT=9001
# Address the API binds to. Defaults to 127.0.0.1, so only this machine can reach it; it serves private Altinn Studio
# content fetched with your Gitea token. Set 0.0.0.0 only on a network you trust.
API_HOST=127.0.0.1
# Host names the API answers to besides localhost and IP addresses, comma-separated. Any other name in a request's Host
# header is refused, which stops a web page from reaching the API through DNS rebinding.
ALLOWED_HOSTS=
GITEA_TOKEN=your_token_here
# Origin allowed to call this API via CORS (the local dev client). Defaults to http://localhost:9000.
CLIENT_ORIGIN=http://localhost:9000
# Git branch to fetch Altinn Studio repo files from. Defaults to master; set to main for apps that use it.
GITEA_BRANCH=master
# How long (ms) to cache expensive endpoint responses, and the testmotor's answers, in memory. Defaults to 60000; set to 0 to disable.
CACHE_TTL_MS=60000
# Print every log event as it happens instead of only the per-request summary report. Defaults to off.
LOG_VERBOSE=0
# Maximum simultaneous requests to Altinn Studio, shared across all endpoints. Defaults to 16.
ALTINN_STUDIO_CONCURRENCY=16
# How long (ms) one request to Altinn Studio, npm, GitHub or the testmotor may take, body included, before it is abandoned. Defaults to 30000.
REQUEST_TIMEOUT_MS=30000
# Base URL of the FtPB testmotor, which serves the main form and subform example data and re-stamps its date fields on every
# request. Defaults to the hosted instance below; point it at your own to work against a local one.
TESTMOTOR_URL=https://app-ftpb-testmotor.azurewebsites.net
# Where the example data the testmotor does not serve lives, which is the one main form it has no data for.
# Expects forms/{dataType}/*.xml. Defaults to api/data/exampleData in this repo.
EXAMPLE_DATA_DIR=
