API_PORT=9001
GITEA_TOKEN=your_token_here
# Origin allowed to call this API via CORS (the local dev client). Defaults to http://localhost:9000.
CLIENT_ORIGIN=http://localhost:9000
# Git branch to fetch Altinn Studio repo files from. Defaults to master; set to main for apps that use it.
GITEA_BRANCH=master
# How long (ms) to cache expensive endpoint responses in memory. Defaults to 60000; set to 0 to disable.
CACHE_TTL_MS=60000
# Print every log event as it happens instead of only the per-request summary report. Defaults to off.
LOG_VERBOSE=0
# Maximum simultaneous requests to Altinn Studio, shared across all endpoints. Defaults to 16.
ALTINN_STUDIO_CONCURRENCY=16
